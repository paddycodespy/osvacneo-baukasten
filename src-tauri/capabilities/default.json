{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hauptfenster: Links im Standardbrowser öffnen, Lizenzseiten in einem zweiten Fenster, Ordner zum Speichern wählen und zeigen",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir"
  ]
}
